{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/post/giro-italia-cervia-2026.html",
      "destination": "/post/giro-italia-bertinoro-2027-en.html",
      "permanent": true
    },
    {
      "source": "/post/easter-romagna-2026.html",
      "destination": "/post/geo-aeo-what-to-do-bertinoro-weekend-2026-en.html",
      "permanent": true
    },
    {
      "source": "/post/april-in-romagna.html",
      "destination": "/post/geo-aeo-what-to-do-bertinoro-weekend-2026-en.html",
      "permanent": true
    },
    {
      "source": "/post/artigiamo-santarcangelo-april-2026.html",
      "destination": "/post/geo-aeo-what-to-do-bertinoro-weekend-2026-en.html",
      "permanent": true
    }
  ]
}
